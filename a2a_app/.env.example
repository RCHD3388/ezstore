# The deterministic Coordinator needs no model or credentials. These optional
# settings remain for experimental wrappers; never commit a real key.
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.8-flash

# Required: independently running quotation A2A specialist.
QUOTATION_AGENT_CARD_URL=http://localhost:8011/a2a/quotation_agent/.well-known/agent-card.json
# Customer Overview-only Sales Insight A2A specialist.
SALES_INSIGHT_AGENT_CARD_URL=http://localhost:8012/.well-known/agent-card.json

# Local Coordinator listener / Agent Card URL.
APP_URL=http://127.0.0.1:8013
A2A_TIMEOUT_SECONDS=180
